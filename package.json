{
  "name": "post-cards",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "db:seed": "pnpm --filter @post-cards/server db:seed",
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --filter @post-cards/mobile dev",
    "dev:server": "pnpm --filter @post-cards/server dev",
    "lint": "turbo run lint",
    "prepare": "effect-language-service patch"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.1",
    "turbo": "^2.10.7",
    "typescript": "~6.0.3"
  }
}
